<mxfile host="app.diagrams.net">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="680" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- kind cluster boundary -->
        <mxCell id="cluster" value="kind cluster &lt;b&gt;sen421&lt;/b&gt;: 3 nodes as Docker containers on one host (Windows 11, Docker Desktop)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=bottom;fontStyle=2;fontSize=12;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="600" height="440" as="geometry" />
        </mxCell>

        <!-- clients -->
        <mxCell id="clients" value="&lt;b&gt;probe.py&lt;/b&gt; (10 req/s) / &lt;b&gt;k6&lt;/b&gt; load&lt;br&gt;containers on Docker network &lt;i&gt;kind&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="20" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- control plane -->
        <mxCell id="cp" value="&lt;b&gt;control-plane node&lt;/b&gt;&lt;br&gt;NodePort 30080, kube-proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="130" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- api service -->
        <mxCell id="svc" value="Service &lt;b&gt;api&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="220" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- workers -->
        <mxCell id="w1" value="&lt;b&gt;worker 1&lt;/b&gt;&lt;br&gt;api pod(s)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flask + gunicorn, 100m / 500m CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="&lt;b&gt;worker 2&lt;/b&gt;&lt;br&gt;api pod(s)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Flask + gunicorn, 100m / 500m CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="310" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- redis -->
        <mxCell id="redis" value="Service &lt;b&gt;redis&lt;/b&gt; → Redis pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="420" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- metrics-server and HPA -->
        <mxCell id="ms" value="&lt;b&gt;metrics-server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="130" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hpa" value="&lt;b&gt;HPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;target 50% / 80%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="215" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="clients" target="cp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="cp" target="svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="svc" target="w1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="svc" target="w2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="w1" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1" source="w2" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="CPU usage" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ms" target="hpa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="scales Deployment" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hpa" target="w2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
